{
  "name": "threads-of-dandora-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Responsive documentary website for Threads of Dandora",
  "scripts": {
    "images": "node scripts/optimize-images.mjs",
    "serve": "http-server . -a 127.0.0.1 -p 4173 -c-1",
    "test:responsive": "playwright test tests/responsive.spec.mjs tests/compatibility.spec.mjs tests/visual.spec.mjs",
    "test:responsive:update": "playwright test tests/visual.spec.mjs --project=chromium --update-snapshots",
    "test:a11y": "playwright test tests/accessibility.spec.mjs",
    "test:lighthouse": "lhci autorun --config=./lighthouserc.cjs",
    "test:browsers:install": "playwright install chromium firefox webkit",
    "verify": "npm run test:responsive && npm run test:a11y && npm run test:lighthouse"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.64.1",
    "http-server": "14.1.1",
    "sharp": "0.35.5"
  }
}
